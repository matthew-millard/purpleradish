# Postgres connection string (Neon)
DATABASE_URL=postgres://user:password@host/purpleradish

# Secret used to sign session cookies. Generate one with: openssl rand -base64 32
SESSION_SECRET=change-me

# Resend API key for transactional email (verification). https://resend.com/api-keys
RESEND_API_KEY=re_change_me

# Public base URL, used to build absolute verification links. No trailing slash.
# Dev: the React Router (Vite) server defaults to port 5173.
# Prod: set to your deployed origin, e.g. https://purpleradish.io
APP_URL=http://localhost:5173

# Upstash Redis for rate limiting. 
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=change-me